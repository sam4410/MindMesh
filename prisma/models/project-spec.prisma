// What a generated document is: a technical spec, or architecture decision records (spec 58).
enum SpecKind {
  SPEC
  ADR
}

// Metadata for a generated spec; the Markdown itself lives in Vercel Blob at specs/{projectId}/{id}.md.
model ProjectSpec {
  // uuid so the generate-spec task can choose the ID before uploading to the path that contains it.
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  filePath  String // Vercel Blob URL of the Markdown file
  kind      SpecKind @default(SPEC)
  // URL of the newest Confluence page it was published to (spec 61); each publish creates a new page.
  publishedUrl String?
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}
